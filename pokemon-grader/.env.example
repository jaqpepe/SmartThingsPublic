# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Anthropic API key for the browser-based grading UI
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Server (Railway) ──────────────────────────────────────────────────────────
# Anthropic API key for the email pipeline server
ANTHROPIC_API_KEY=your_anthropic_key_here

# Resend API key — get from resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address for outgoing grading report emails
# Must be a verified domain/address in your Resend account
FROM_EMAIL=grader@yourdomain.com

# A random secret used to verify webhook authenticity (choose any string)
INBOUND_WEBHOOK_SECRET=change_me_to_a_random_secret_string

# Server port (Railway sets this automatically; only needed for local dev)
PORT=3001
